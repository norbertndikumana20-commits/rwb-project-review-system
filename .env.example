# ============================================
# RWB Project Review System — Configuration
# ============================================
# Copy this file to .env and fill in your values.
# Docker Compose uses these variables automatically.

# --- PostgreSQL ---
POSTGRES_DB=RWB-Project
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeMe2025

# --- Backend (Spring Boot) ---
SPRING_PROFILES_ACTIVE=default
SERVER_PORT=8080
JWT_SECRET=replace-with-a-random-64-char-string-in-production

# --- SMTP / Email (leave MAIL_ENABLED=false for dev mode) ---
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=your-email@gmail.com
MAIL_DISPLAY_NAME=RWB Project Review
MAIL_VERIFY_URL=http://localhost:5173/verify-email

# --- Frontend ---
VITE_API_URL=http://localhost:8080
