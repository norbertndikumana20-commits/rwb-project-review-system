# RWB verification mail — copy this file to `.env`, fill in YOUR values, then run:
#
#     bash run-mail.sh
#
# `.env` is gitignored, so your credentials never get committed.
#
# ─────────────────────────────────────────────────────────────────────────────
# PROVIDER CHEAT SHEET (exact values)
# ─────────────────────────────────────────────────────────────────────────────
# GMAIL / GOOGLE WORKSPACE (app password)
#   Requires 2-Step Verification on the account, then generate an App Password
#   at https://myaccount.google.com/apppasswords (16 chars).
#     MAIL_HOST=smtp.gmail.com
#     MAIL_PORT=587
#     MAIL_USERNAME=you@gmail.com            (full address)
#     MAIL_PASSWORD=abcd efgh ijkl mnop      (16-char app password, spaces ok)
#     MAIL_FROM=you@gmail.com
#
# OUTLOOK.COM (personal)
#   App password from Microsoft account security settings (requires 2FA).
#     MAIL_HOST=smtp-mail.outlook.com
#     MAIL_PORT=587
#     MAIL_USERNAME=you@outlook.com
#     MAIL_PASSWORD=<app password>
#     MAIL_FROM=you@outlook.com
#
# MICROSOFT 365 / EXCHANGE ONLINE (business)
#   SMTP AUTH must be enabled for the mailbox by your tenant admin; with MFA on,
#   use an app password.
#     MAIL_HOST=smtp.office365.com
#     MAIL_PORT=587
#     MAIL_USERNAME=you@yourdomain.com
#     MAIL_PASSWORD=<app password>
#     MAIL_FROM=you@yourdomain.com
#
# GENERIC BUSINESS SMTP RELAY (e.g. SendGrid, Mailgun, Amazon SES, Brevo)
#   Use the relay's own host/port and its credentials — usually:
#     MAIL_HOST=smtp.sendgrid.net            (or your provider's relay host)
#     MAIL_PORT=587
#     MAIL_USERNAME=apikey                   (provider-specific, often 'apikey')
#     MAIL_PASSWORD=<provider API key>
#     MAIL_FROM=no-reply@yourdomain.com
# ─────────────────────────────────────────────────────────────────────────────
#
# Master switch. Set true only AFTER filling in real credentials — otherwise
# run-mail.sh refuses to start (registrations would fail instead of emailing).
MAIL_ENABLED=true

# SMTP transport
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Sender identity
MAIL_FROM=
MAIL_DISPLAY_NAME=RWB Project Review

# Frontend verification page the emailed link points at
MAIL_VERIFY_URL=http://localhost:5173/verify-email
